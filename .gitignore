# =====================================================================
# .gitignore —— 久伴博客（PHP 源码 + dist 静态产物）
# 规则原则：只排除「机密」和「本机私有 / 临时文件」；
#          源码（*.php、tools/、public/、.github/）一律入库。
# =====================================================================

# ---- 机密：绝不入库（含数据库密码，模板见 app/config.example.php）----
*.php

# ---- 本机私有数据 ----
# 后台上传的图片：留在主机，页面用的是 dist/ 里的静态副本
tools/

# ---- 临时 / 预览文件 ----
.preview-*
.studio-*
tmp/

# ---- 工具产物 ----
# 久伴 Agent 的会话、命令日志；Aitemp 是 AI 的临时产物目录
.jbagent/
Aitemp/

# ---- 日志 ----
*.log

# ---- 系统垃圾 ----
.DS_Store
Thumbs.db
desktop.ini

# 注：dist/ 是发布产物，故意不忽略 —— GitHub Pages 直接发布该目录；
#     不要在这里加 dist/，否则 Pages 没有内容可部署。

# MCP 产物目录（久伴 Agent 自动添加）
ai_temp/
