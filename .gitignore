# 发布产物：随代码提交并部署到 GitHub Pages
# dist/

# 本地配置，含数据库密码，绝不入库
app/config.php

# 后台上传的图片：留在主机上，静态产物由 dist/ 同步
app/assets/uploads/

# 临时截图 / 预览文件
.preview-*
.studio-*

# 系统垃圾
.DS_Store
Thumbs.db
desktop.ini
.jbagent/
tmp/
*.log

# MCP 产物目录（久伴 Agent 自动添加）
Aitemp/

# 源码目录显式保留：*.php / tools/ / blog/public/ / .github 曾被误写进忽略名单，
# 导致重新 init 仓库时 app/lib、app/templates、public/*.php、.github/workflows
# 全部漏提交（推 GitHub 时才会发现少了一堆文件）。敏感配置由上面的
# app/config.php 精确排除即可，不需要整类忽略。
